# Copy to .env.local and fill in what you need. Nothing here is required to
# run the public site: unset, the app talks to the hosted API and the features
# that need a key say so rather than failing silently.

# Which delivery API to read. Both are needed and must agree: the first is for
# server-side renders and route handlers, the second is inlined into the
# browser bundle for the feeds menu and the /v1/events stream, which call the
# API directly. Whichever host serves them must list this origin in its CORS
# origins, or the status dot reads red while every server-side proxy works.
DRYOS_API_URL=https://api.dryos.ai
NEXT_PUBLIC_DRYOS_API_URL=https://api.dryos.ai

# Identity. Without these the site runs and nobody can sign in; everything
# public — the landing page, the catalogue, the docs — works regardless.
# The publishable key is public by design. The `sb_secret_…` service key is
# NOT: it belongs in a server environment only, never in this file and never
# behind a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Maps. A Mapbox public token is meant to be read by the browser and should be
# restricted by URL on Mapbox's side. With none, a map tile says so.
MAPBOX_TOKEN=

# The component refine box, and the page-level chat, are the only things that
# call a model. Everything else in the build path is generated, not prompted.
ANTHROPIC_API_KEY=

# Optional. The starter repo the landing page offers to clone, and a token to
# lift GitHub's unauthenticated rate limit when reading its star count. With
# no public repo at that name, the clone block renders nothing.
# DRYOS_GITHUB_REPO=
# GITHUB_TOKEN=
